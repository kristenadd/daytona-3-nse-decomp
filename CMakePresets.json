{
  "version": 6,
  "configurePresets": [
    {
      "name": "mac-host",
      "displayName": "macOS host (tools and tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac-host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "ios-sim",
      "displayName": "iOS Simulator app (arm64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ios-sim",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0"
      }
    },
    {
      "name": "ios-device",
      "displayName": "iPhone / iPad app (arm64; pass -DDCUSA_IOS_TEAM=<team id>)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios-device",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0"
      }
    },
    {
      "name": "visionos-sim",
      "displayName": "Apple Vision Pro Simulator app (arm64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/visionos-sim",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_SYSTEM_NAME": "visionOS",
        "CMAKE_OSX_SYSROOT": "xrsimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "2.0"
      }
    },
    {
      "name": "visionos-device",
      "displayName": "Apple Vision Pro app (arm64; pass -DDCUSA_IOS_TEAM=<team id>)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/visionos-device",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "visionOS",
        "CMAKE_OSX_SYSROOT": "xros",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "2.0"
      }
    },
    {
      "name": "mac-sdl",
      "displayName": "macOS with SDL3 and Vulkan (MoltenVK): tests the Linux code paths",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac-sdl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "DCUSA_PLATFORM": "sdl"
      }
    },
    {
      "name": "linux-deck",
      "displayName": "Linux x86_64 (Steam Deck), cross-compiled against the Steam Runtime sysroot",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-deck",
      "toolchainFile": "${sourceDir}/cmake/linux-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mac-host",
      "configurePreset": "mac-host"
    },
    {
      "name": "ios-sim",
      "configurePreset": "ios-sim"
    },
    {
      "name": "ios-device",
      "configurePreset": "ios-device",
      "configuration": "RelWithDebInfo",
      "nativeToolOptions": [
        "-allowProvisioningUpdates"
      ]
    },
    {
      "name": "visionos-sim",
      "configurePreset": "visionos-sim"
    },
    {
      "name": "visionos-device",
      "configurePreset": "visionos-device",
      "configuration": "RelWithDebInfo",
      "nativeToolOptions": [
        "-allowProvisioningUpdates"
      ]
    },
    {
      "name": "mac-sdl",
      "configurePreset": "mac-sdl"
    },
    {
      "name": "linux-deck",
      "configurePreset": "linux-deck"
    }
  ],
  "testPresets": [
    {
      "name": "mac-host",
      "configurePreset": "mac-host",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    }
  ]
}
