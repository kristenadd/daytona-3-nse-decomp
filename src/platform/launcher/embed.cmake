# Writes a C++ file holding the launcher's fonts and logo as byte arrays, so
# every platform has them without bundling files: cmake -P with IN_FILES
# (name=path;...) and OUT.
set(body "// Generated by src/platform/launcher/embed.cmake. Do not edit.\n#include \"platform/launcher/assets.hpp\"\n\nnamespace dcusa::launcher {\nnamespace {\n")
set(table "")
foreach(entry IN LISTS IN_FILES)
  string(REPLACE "=" ";" parts "${entry}")
  list(GET parts 0 name)
  list(GET parts 1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR size "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
  string(APPEND body "const unsigned char k_${name}[${size}] = {\n${bytes}};\n")
  string(APPEND table "        {\"${name}\", k_${name}, ${size}},\n")
endforeach()
string(APPEND body "}  // namespace\n\nstd::span<const unsigned char> asset(std::string_view name) {\n    static const struct {\n        const char* name;\n        const unsigned char* data;\n        std::size_t size;\n    } kAssets[] = {\n${table}    };\n    for (const auto& a : kAssets)\n        if (name == a.name) return {a.data, a.size};\n    return {};\n}\n\n}  // namespace dcusa::launcher\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
