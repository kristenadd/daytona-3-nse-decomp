<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The guest's 4 GB address space is reserved up front (guest_memory.cpp). -->
    <key>com.apple.developer.kernel.extended-virtual-addressing</key><true/>
    <!-- The game's working set (textures, the decoded BC copies, 4x MSAA targets). -->
    <key>com.apple.developer.kernel.increased-memory-limit</key><true/>
</dict>
</plist>
